{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "test": "vitest run",
        "worker:dev": "wrangler dev",
        "worker:typecheck": "tsc --noEmit",
        "worker:test": "vitest run",
        "db:migrate:local": "wrangler d1 migrations apply gundjatech-db --local",
        "db:migrate:remote": "wrangler d1 migrations apply gundjatech-db --remote"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261121.1",
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2",
        "vitest": "^5.1.1",
        "wrangler": "^4.166.0"
    },
    "dependencies": {
        "chart.js": "^4.6.1",
        "hono": "^4.13.19"
    }
}
